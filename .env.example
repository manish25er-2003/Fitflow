# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Email Provider Configuration (Optional for live delivery)
# Option 1: Resend API Key (Recommended)
VITE_RESEND_API_KEY=re_your_resend_api_key
VITE_EMAIL_FROM=Fitflow Gym <onboarding@resend.dev>

# Option 2: Custom Email Webhook or SendGrid
# VITE_EMAIL_SERVICE_URL=https://your-api.com/send-email
# VITE_SENDGRID_API_KEY=SG.your_sendgrid_key

# SMS Provider Configuration (Optional for live delivery)
# Option 1: Custom SMS Webhook endpoint (Twilio / Fast2SMS / AWS SNS / Cloud Function)
# VITE_SMS_SERVICE_URL=https://your-api.com/send-sms

# Option 2: Twilio Credentials
# VITE_TWILIO_ACCOUNT_SID=AC_your_account_sid
# VITE_TWILIO_AUTH_TOKEN=your_auth_token
# VITE_TWILIO_FROM_NUMBER=+1234567890
